// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Аниматоры
model Animator {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  pricePerHour Int     @default(0)
  popular     Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Квесты
model Quest {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  price       Int      @default(0)
  duration    Int      @default(60) // в минутах
  minAge      Int      @default(6)
  maxAge      Int?
  popular     Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Шоу-программы
model Show {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  price       Int      @default(0)
  duration    Int      @default(30) // в минутах
  popular     Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Мастер-классы
model MasterClass {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  price       Int      @default(0)
  duration    Int      @default(45) // в минутах
  minAge      Int      @default(5)
  maxAge      Int?
  popular     Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Дополнительные услуги
model AdditionalService {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  price       Int      @default(0)
  popular     Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Галерея
model GalleryItem {
  id          Int      @id @default(autoincrement())
  imageUrl    String
  title       String?
  description String?
  category    String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Администраторы
model Admin {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  name        String?
  role        String   @default("admin")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
